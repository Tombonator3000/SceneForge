# SceneForge API Configuration
# Copy this file to .env and fill in your API keys

# Suno Music Generation (via third-party provider)
SUNO_API_KEY=
SUNO_PROVIDER=sunoapi  # sunoapi | cometapi

# Kling Video Generation
KLING_API_KEY=
KLING_PROVIDER=kie  # official | kie | piapi | kling3api

# Freepik Image Generation (official API)
FREEPIK_API_KEY=
